# notflux-agent — deployment env vars
# Copy to .env (gitignored) and fill in values before running deploy.py.
# Optionally install python-dotenv so deploy.py picks this up automatically:
#   pip install python-dotenv

# PingOne environment
PINGONE_ENV_ID=59bb6a66-e76e-490c-b83a-884c50423da4

# Confidential client for Exchange 2 (agent_token → mcp_token)
# Create a PingOne application with Token Exchange grant type.
PINGONE_CLIENT_ID=
PINGONE_CLIENT_SECRET=

# aud claim the agent validates on the incoming agent_token (must match
# PINGONE_AGENT_SCOPE in the notflux-app backend .env — check the token's aud claim)
PINGONE_AGENT_AUDIENCE=

# Scope to request in Exchange 2 — PingOne maps this to the MCP resource server aud
PINGONE_MCP_SCOPE=

# Exchange 2 token endpoint. Leave blank to use the PingOne env's endpoint
# (https://auth.pingone.com/<PINGONE_ENV_ID>/as/token). Set it to point Exchange 2
# at a different provider WITHOUT changing code — e.g. a second NotFlux agent that
# does the PingFed exchange over the same PingGateway routes:
#   TOKEN_EXCHANGE_ENDPOINT=https://<pingfed-host>/as/token
# (PINGONE_CLIENT_ID/SECRET/SCOPE above are the Exchange 2 client for whichever
# provider this endpoint points at.)
TOKEN_EXCHANGE_ENDPOINT=

# Runtime identity — the persistent Agent Identifier for the 3rd-party exchange.
# When set, the engine runs AS this service account, so the metadata-server OIDC
# token carries this email/sub (per-agent, stable across --update and --create).
# Leave blank to use the shared, project-level managed Agent Engine service agent.
# Use a distinct SA per agent, e.g. notflux-agent@... (PingOne) and
# pingfed-agent@... (PingFed) for the 3rd-party exchange demo.
# Prereq: grant the AE service agent roles/iam.serviceAccountUser on this SA, and
# give this SA roles/aiplatform.user (see deploy.py header for the exact command).
AGENT_SERVICE_ACCOUNT=
