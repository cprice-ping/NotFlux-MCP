# --- Actor-token delegation (PingFed) ---------------------------------------
# PingOne does NOT accept a 3rd Party actor token — leave these unset for the P1 agent.
# For a PingFed agent, set SEND_ACTOR_TOKEN=true so Exchange 2 attaches the GCP
# workload-identity token as the actor assertion (act.sub = this agent's SA)
# alongside the subject (the P1 agent token carrying the human).
SEND_ACTOR_TOKEN=true
# Token-type URI for the Google OIDC token. Default is ...:jwt (what PingFed
# expects); override only if your policy wants something else.
ACTOR_TOKEN_TYPE=
# aud minted into the Google actor token — the claim that matters; must name the
# validating provider (PF). Defaults to TOKEN_EXCHANGE_ENDPOINT; set only if PF
# expects a specific audience string.
ACTOR_TOKEN_AUDIENCE=
# Usually unnecessary: only if PF pins the ISSUED token's aud via a request param
# rather than its own policy. Most setups match the issued aud in PF config.
EXCHANGE_AUDIENCE=
EXCHANGE_RESOURCE=

# PingOne environment (still needed to validate the incoming agent_token's aud)
PINGONE_ENV_ID=59bb6a66-e76e-490c-b83a-884c50423da4
# aud claim to validate on the incoming agent_token (same as PingOne agent)
PINGONE_AGENT_AUDIENCE=notflux-agent

# Exchange 2: call PingFed instead of PingOne.
# PINGONE_CLIENT_ID/SECRET/SCOPE are the Exchange 2 creds regardless of provider name.
TOKEN_EXCHANGE_ENDPOINT=https://facile-milkwort-dilly.ping-devops.com/as/token
# P1 agent_token is a JWT — PingFed validates it as such (not an opaque access_token)
SUBJECT_TOKEN_TYPE=urn:ietf:params:oauth:token-type:jwt
PINGONE_CLIENT_ID=teGoogle
PINGONE_CLIENT_SECRET=BBN5JHPsIRTcZNcid46rHOB5SV0x7AkwCuF7NQGKcTChIL4AFq9pkHIEQC72JRd4
PINGONE_MCP_SCOPE=use_gateway

# Runtime identity — the persistent Agent Identifier for the 3rd-party exchange.
# When set, the engine runs AS this service account, so the metadata-server OIDC
# token carries this email/sub (per-agent, stable across --update and --create).
# Leave blank to use the shared, project-level managed Agent Engine service agent.
# Use a distinct SA per agent, e.g. notflux-agent@... (PingOne) and
# pingfed-agent@... (PingFed) for the 3rd-party exchange demo.
# Prereq: grant the AE service agent roles/iam.serviceAccountUser on this SA, and
# give this SA roles/aiplatform.user (see deploy.py header for the exact command).
AGENT_SERVICE_ACCOUNT=

# Gateway MCP URL — PingFed agent uses /mcp-pf so the gateway validates with
# PingFed JWT validation rather than PingOne introspection.
MCP_URL=https://notflux-gateway.ping-devops.com/mcp-pf
